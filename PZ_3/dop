# Задача 1. Произведение двух чисел
a = int(input("введите первое число:"))
b = int(input("введите второе число:"))
proizvedenie = a * b

if proizvedenie < 0:
    result = proizvedenie * 8
else:
    result = proizvedenie * 1.5
print("Рузультат:", result)

# Задача 2. Четное\нечетное число
chislo =  int(input("введите число:"))

if chislo % 2 == 0:
    result = chislo / 4
else:
    result = chislo * 5
print("Рузультат:", result)


# Задача 3. Двухзначное число
chislo = int(input("введите двухзначное число:"))

cifra1 = chislo // 10
cifra2 = chislo % 10
summa = cifra1 + cifra2

if summa % 2 == 0:
    result = chislo + 2
else:
    result = chislo - 2
print("Рузультат:", result)

#Задание 4. Положительное\Отрицательное число
